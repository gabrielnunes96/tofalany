# Copie este arquivo para ".env" nesta mesma pasta e preencha. O ".env" não vai para o git.
# Os campos vazios são obrigatórios: o servidor/compose não sobe sem eles.

# Nome do servidor que aparece no app.
NOME_SERVIDOR=ToFalany

# Código de convite inicial (depois dá para trocar pelo app, em Convite). Algo difícil de adivinhar.
CODIGO_CONVITE=

# Endereço que as pessoas usam para entrar (aparece no link de convite).
#   Tailscale: http://<IP-ou-nome-do-tailnet>:3000
#   VPS:       https://<seu-domínio>
URL_PUBLICA=

# Segredo do LiveKit (voz, vídeo e tela): um texto longo e aleatório. Gere com:  openssl rand -hex 32
LIVEKIT_API_SECRET=

# Endereço do LiveKit para os apps — no MESMO host de URL_PUBLICA (o app só fala com esse host).
#   Tailscale: ws://<mesmo IP/nome do tailnet>:7880
#   VPS:       wss://<seu-domínio>   (o Caddy leva /rtc ao LiveKit)
LIVEKIT_URL=

# IP que o LiveKit anuncia para o áudio/vídeo:
#   Tailscale: o IP do tailnet deste computador (tailscale ip -4)
#   VPS:       o IP público da VPS
LIVEKIT_NODE_IP=

# Em que endereço as portas ficam abertas no computador:
#   Tailscale: o IP do tailnet nas duas (ninguém de fora do tailnet acessa)
#   VPS:       BIND_IP_HTTP=127.0.0.1 (só o Caddy fala com o servidor) e BIND_IP_MIDIA=0.0.0.0
BIND_IP_HTTP=
BIND_IP_MIDIA=

# Só na VPS (perfil "vps"): o domínio do Caddy (HTTPS automático) e o servidor atrás dele.
# DOMINIO=fala.exemplo.com
# ATRAS_DE_PROXY=true

# Opcionais: limite de contas (padrão 20), dias de auditoria (padrão 30), porta do servidor no host,
# versão da imagem (para voltar a uma anterior).
# LIMITE_CONTAS=20
# AUDITORIA_DIAS=30
# PORTA_SERVIDOR=3000
# VERSAO=local
