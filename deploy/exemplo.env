# Copie este arquivo para ".env" nesta mesma pasta e preencha. O ".env" não vai para o git.
# Os campos vazios são obrigatórios: o servidor/compose não sobe sem eles.

# Nome do servidor que aparece no app.
NOME_SERVIDOR=ToFalany

# Código de convite inicial (depois dá para trocar pelo app, em Convite). Algo difícil de adivinhar.
CODIGO_CONVITE=

# Endereço que as pessoas usam para entrar (aparece no link de convite).
#   Tailscale: http://<IP-ou-nome-do-tailnet>:3000
#   VPS:       https://<seu-domínio>
URL_PUBLICA=

# Segredo do LiveKit (voz, vídeo e tela): um texto longo e aleatório. Gere com:  openssl rand -hex 32
LIVEKIT_API_SECRET=

# Endereço do LiveKit para os apps — no MESMO host de URL_PUBLICA (o app só fala com esse host).
#   Tailscale: ws://<mesmo IP/nome do tailnet>:7880
#   VPS:       wss://<seu-domínio>   (o Caddy leva /rtc ao LiveKit)
LIVEKIT_URL=

# IP que o LiveKit anuncia para o áudio/vídeo:
#   Tailscale: o IP do tailnet deste computador (tailscale ip -4)
#   VPS:       o IP público da VPS
LIVEKIT_NODE_IP=

# Em que endereço as portas ficam abertas no computador:
#   Tailscale: o IP do tailnet nas duas (ninguém de fora do tailnet acessa)
#   VPS:       BIND_IP_HTTP=127.0.0.1 (só o Caddy fala com o servidor) e BIND_IP_MIDIA=0.0.0.0
BIND_IP_HTTP=
BIND_IP_MIDIA=

# Só na VPS (perfil "vps"): o domínio do Caddy (HTTPS automático) e o servidor atrás dele.
# DOMINIO aceita uma lista com vírgula (o nome fixo e o antigo, enquanto ele existir); a voz sai pelo nome por
# onde a pessoa chegou. COMPOSE_FILE liga o docker-compose.vps.yml: pedido "Atualizar o servidor agora",
# gerador de token do YouTube (bgutil) e o Caddy como único proxy confiável. O vm.sh grava tudo isso.
# DOMINIO=fala.exemplo.com
# ATRAS_DE_PROXY=true
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
# O token do DuckDNS NÃO vai aqui (este arquivo chega inteiro ao contêiner): fica em deploy/duckdns.token.

# Opcionais: limite de contas (padrão 20), dias de auditoria (padrão 30), porta do servidor no host,
# versão da imagem (para voltar a uma anterior).
# LIMITE_CONTAS=20
# AUDITORIA_DIAS=30
# PORTA_SERVIDOR=3000
# VERSAO=local

# Opcionais: pontos e loja. Ganho por minuto em voz e preços (mudar e reiniciar o servidor; o app não precisa
# de versão nova). Padrões: 1 ponto por minuto; tema 600; vales de 7 dias 720p60 200, 1080p30 300, 1080p60 600.
# PONTOS_POR_MINUTO=1
# PRECO_TEMA=600
# PRECO_VALE_720P60=200
# PRECO_VALE_1080P30=300
# PRECO_VALE_1080P60=600
# Áudios da loja, por raridade (padrões: comum 100, raro 300, épico 800, lendário 2000).
# PRECO_AUDIO_COMUM=100
# PRECO_AUDIO_RARO=300
# PRECO_AUDIO_EPICO=800
# PRECO_AUDIO_LENDARIO=2000

# Opcional: busca de GIF (Klipy). Crie a chave no painel da Klipy (partner.klipy.com → API Keys), deixe os
# anúncios desligados e peça a chave de produção (a de teste aceita só 100 buscas por hora). Sem a chave, o
# botão GIF não aparece. A chave é entregue ao app de quem está logado: os termos da Klipy pedem que o app a chame direto.
# Se alguém de confiança duvidosa for expulso ou banido, gere outra chave no painel da Klipy e reinicie o servidor.
# KLIPY_API_KEY=
