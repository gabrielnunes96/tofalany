# VPS com HTTPS automático (Let's Encrypt). DOMINIO vem do .env: um nome (ex.: fala.exemplo.com) ou uma lista
# explícita separada por vírgula (ex.: "tofalany.duckdns.org, 1-2-3-4.sslip.io"), cada um com o próprio certificado.
# Sem curinga nem certificado sob demanda: só os nomes da lista.
# Tudo no mesmo endereço: o app fala com o servidor e com o LiveKit pelo mesmo host (exigido pelo app).
{$DOMINIO} {
	encode zstd gzip

	# Sinalização e API do LiveKit.
	@livekit path /rtc /rtc/* /twirp/*
	reverse_proxy @livekit livekit:7880

	# Chat, contas, arquivos, convite e o tempo real (Socket.IO).
	reverse_proxy server:3000
}
